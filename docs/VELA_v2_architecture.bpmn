<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="BlackBird_full" targetNamespace="http://blackbird.protocol" exporter="Kimi Code CLI" exporterVersion="2.1">
  <collaboration id="Collaboration_1">
    <participant id="Participant_Client" name="Client / e2e Harness" processRef="Process_Client"/>
    <participant id="Participant_WebApp" name="Web App (Next.js API proxy)" processRef="Process_WebApp"/>
    <participant id="Participant_NanoRPC" name="Nano RPC (rpc.nano.to)" processRef="Process_NanoRPC"/>
    <participant id="Participant_Indexer" name="BlackBird Indexer" processRef="Process_Indexer"/>
    <participant id="Participant_Guardian" name="BlackBird Guardian" processRef="Process_Guardian"/>
    <participant id="Participant_Ledger" name="Nano Ledger" processRef="Process_Ledger"/>
    <messageFlow id="MF_ClientDeposit" sourceRef="Task_ClientSubmitDeposit" targetRef="Start_WebDeposit"/>
    <messageFlow id="MF_ClientProve" sourceRef="Task_ClientRequestProof" targetRef="Start_WebProve"/>
    <messageFlow id="MF_ClientWithdraw" sourceRef="Task_ClientRequestWithdraw" targetRef="Start_WebWithdraw"/>
    <messageFlow id="MF_ClientAccountInfo" sourceRef="Task_ClientGetAccountInfo" targetRef="Start_WebAccountInfo"/>
    <messageFlow id="MF_ClientPending" sourceRef="Task_ClientGetPending" targetRef="Start_WebPending"/>
    <messageFlow id="MF_ClientWork" sourceRef="Task_ClientGetWork" targetRef="Start_WebWork"/>
    <messageFlow id="MF_ClientBroadcast" sourceRef="Task_ClientBroadcast" targetRef="Start_WebBroadcast"/>
    <messageFlow id="MF_WebToNanoRPC" sourceRef="Task_WebCallNanoRPC" targetRef="Start_NanoRPC"/>
    <messageFlow id="MF_WebToIndexerDeposit" sourceRef="Task_WebForwardDeposit" targetRef="Start_IndexerDeposit"/>
    <messageFlow id="MF_WebToIndexerProve" sourceRef="Task_WebForwardProve" targetRef="Start_IndexerProve"/>
    <messageFlow id="MF_WebToGuardian" sourceRef="Task_WebForwardWithdraw" targetRef="Start_GuardianWithdraw"/>
    <messageFlow id="MF_IndexerToNanoRPC" sourceRef="Task_IndexerBlocksInfo" targetRef="Start_NanoRPC"/>
    <messageFlow id="MF_GuardianToNanoRPC" sourceRef="Task_GuardianAccountInfo" targetRef="Start_NanoRPC"/>
    <messageFlow id="MF_NanoRPCToLedger" sourceRef="Task_NanoRPCBroadcast" targetRef="Start_LedgerBlock"/>
    <messageFlow id="MF_LedgerToIndexer" sourceRef="Task_LedgerConfirmed" targetRef="Start_IndexerScan"/>
  </collaboration>
  <process id="Process_Client" isExecutable="false">
    <laneSet id="LaneSet_Client">
      <lane id="Lane_User" name="User / Test Script">
        <flowNodeRef>Start_Client</flowNodeRef>
        <flowNodeRef>Task_LoadWallets</flowNodeRef>
        <flowNodeRef>Task_ExternalFund</flowNodeRef>
        <flowNodeRef>Task_ReceiveFunding</flowNodeRef>
        <flowNodeRef>Gateway_HasBalance</flowNodeRef>
        <flowNodeRef>SubProcess_Deposit</flowNodeRef>
        <flowNodeRef>SubProcess_Withdraw</flowNodeRef>
        <flowNodeRef>Task_ReceiveWithdrawal</flowNodeRef>
        <flowNodeRef>End_ClientDone</flowNodeRef>
        <flowNodeRef>End_ClientFail</flowNodeRef>
        <flowNodeRef>Task_ClientGetAccountInfo</flowNodeRef>
        <flowNodeRef>Task_ClientGetPending</flowNodeRef>
        <flowNodeRef>Task_ClientGetWork</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Client" name="Run e2e / user action"/>
    <task id="Task_LoadWallets" name="Load test-wallets.json / connect wallet"/>
    <task id="Task_ExternalFund" name="External funder sends XNO to source address"/>
    <task id="Task_ReceiveFunding" name="Client creates &amp; broadcasts receive block"/>
    <exclusiveGateway id="Gateway_HasBalance" name="Balance ≥ denom + 1 raw?"/>
    <subProcess id="SubProcess_Deposit" name="Deposit + Commitment">
      <startEvent id="Start_SubDeposit" name="Begin deposit"/>
      <task id="Task_DeriveStealth" name="Derive stealth withdrawal key P_w from seed[1]"/>
      <task id="Task_GenerateSecrets" name="Derive n = Blake2b(seed|P_w|&quot;vela/n&quot;), t similarly"/>
      <task id="Task_FetchPoolInfo" name="Fetch pool address derived from guardian seed for denomination"/>
      <task id="Task_ComputeCommitment" name="Compute C = Poseidon(1, n, t, P_w, S_pub)"/>
      <task id="Task_CreateDepositBlock" name="Create state send: source → pool (denom)"/>
      <task id="Task_ComputeDepositWork" name="Compute PoW on source frontier (send threshold)"/>
      <task id="Task_BroadcastDeposit" name="Broadcast deposit block"/>
      <task id="Task_CreateCommitmentBlock" name="Create state send: source → C (1 raw)"/>
      <task id="Task_ComputeCommitmentWork" name="Compute PoW on deposit hash (send threshold)"/>
      <task id="Task_BroadcastCommitment" name="Broadcast commitment block"/>
      <endEvent id="End_SubDeposit" name="Deposit/commitment on-chain"/>
      <sequenceFlow id="SD1" sourceRef="Start_SubDeposit" targetRef="Task_DeriveStealth"/>
      <sequenceFlow id="SD2" sourceRef="Task_DeriveStealth" targetRef="Task_GenerateSecrets"/>
      <sequenceFlow id="SD3" sourceRef="Task_GenerateSecrets" targetRef="Task_FetchPoolInfo"/>
      <sequenceFlow id="SD4" sourceRef="Task_FetchPoolInfo" targetRef="Task_ComputeCommitment"/>
      <sequenceFlow id="SD5" sourceRef="Task_ComputeCommitment" targetRef="Task_CreateDepositBlock"/>
      <sequenceFlow id="SD6" sourceRef="Task_CreateDepositBlock" targetRef="Task_ComputeDepositWork"/>
      <sequenceFlow id="SD7" sourceRef="Task_ComputeDepositWork" targetRef="Task_BroadcastDeposit"/>
      <sequenceFlow id="SD8" sourceRef="Task_BroadcastDeposit" targetRef="Task_CreateCommitmentBlock"/>
      <sequenceFlow id="SD9" sourceRef="Task_CreateCommitmentBlock" targetRef="Task_ComputeCommitmentWork"/>
      <sequenceFlow id="SD10" sourceRef="Task_ComputeCommitmentWork" targetRef="Task_BroadcastCommitment"/>
      <sequenceFlow id="SD11" sourceRef="Task_BroadcastCommitment" targetRef="End_SubDeposit"/>
    </subProcess>
    <subProcess id="SubProcess_Withdraw" name="Withdrawal">
      <startEvent id="Start_SubWithdraw" name="Begin withdrawal"/>
      <task id="Task_RecoverHashes" name="(Resume) recover deposit/commit hashes from account history"/>
      <task id="Task_ClientSubmitDeposit" name="POST /api/deposit {deposit_hash, commit_hash}" isForCompensation="false"/>
      <task id="Task_ClientRequestProof" name="POST /api/prove {n, t, P_w, nullifier, denom, epoch}" isForCompensation="false"/>
      <task id="Task_GenerateZKProof" name="Indexer/snarkjs generates Groth16 proof"/>
      <task id="Task_ClientRequestWithdraw" name="POST /api/withdraw {destination, proof, publicSignals}" isForCompensation="false"/>
      <task id="Task_InspectGuardianBlock" name="Receive signed block &amp; block_hash from guardian"/>
      <task id="Task_ComputeWithdrawWork" name="Compute PoW on block.previous (pool frontier)"/>
      <task id="Task_ClientBroadcast" name="POST /api/broadcast_withdrawal {nullifier, signed block + work}" isForCompensation="false"/>
      <endEvent id="End_SubWithdraw" name="Withdrawal broadcast"/>
      <sequenceFlow id="SW1" sourceRef="Start_SubWithdraw" targetRef="Task_RecoverHashes"/>
      <sequenceFlow id="SW2" sourceRef="Task_RecoverHashes" targetRef="Task_ClientSubmitDeposit"/>
      <sequenceFlow id="SW3" sourceRef="Task_ClientSubmitDeposit" targetRef="Task_ClientRequestProof"/>
      <sequenceFlow id="SW4" sourceRef="Task_ClientRequestProof" targetRef="Task_GenerateZKProof"/>
      <sequenceFlow id="SW5" sourceRef="Task_GenerateZKProof" targetRef="Task_ClientRequestWithdraw"/>
      <sequenceFlow id="SW6" sourceRef="Task_ClientRequestWithdraw" targetRef="Task_InspectGuardianBlock"/>
      <sequenceFlow id="SW7" sourceRef="Task_InspectGuardianBlock" targetRef="Task_ComputeWithdrawWork"/>
      <sequenceFlow id="SW8" sourceRef="Task_ComputeWithdrawWork" targetRef="Task_ClientBroadcast"/>
      <sequenceFlow id="SW9" sourceRef="Task_ClientBroadcast" targetRef="End_SubWithdraw"/>
    </subProcess>
    <task id="Task_ReceiveWithdrawal" name="Create &amp; broadcast receive block to P_w (open/ receive)"/>
    <endEvent id="End_ClientDone" name="Cycle complete"/>
    <endEvent id="End_ClientFail" name="Insufficient balance / failure"/>
    <sequenceFlow id="C0" sourceRef="Start_Client" targetRef="Task_LoadWallets"/>
    <sequenceFlow id="C2" sourceRef="Task_ExternalFund" targetRef="Task_ReceiveFunding"/>
    <sequenceFlow id="C3" sourceRef="Task_ReceiveFunding" targetRef="Gateway_HasBalance"/>
    <sequenceFlow id="C4_Yes" sourceRef="Gateway_HasBalance" targetRef="SubProcess_Deposit" name="Yes"/>
    <sequenceFlow id="C4_No" sourceRef="Gateway_HasBalance" targetRef="End_ClientFail" name="No"/>
    <sequenceFlow id="C5" sourceRef="SubProcess_Deposit" targetRef="SubProcess_Withdraw"/>
    <sequenceFlow id="C6" sourceRef="SubProcess_Withdraw" targetRef="Task_ReceiveWithdrawal"/>
    <sequenceFlow id="C7" sourceRef="Task_ReceiveWithdrawal" targetRef="End_ClientDone"/>
    <task id="Task_ClientGetAccountInfo" name="GET /api/account_info"/>
    <task id="Task_ClientGetPending" name="GET /api/pending"/>
    <task id="Task_ClientGetWork" name="POST /api/work"/>
    <sequenceFlow sourceRef="Task_LoadWallets" targetRef="Task_ClientGetAccountInfo" id="Flow_1000"/>
    <sequenceFlow sourceRef="Task_ClientGetAccountInfo" targetRef="Task_ClientGetPending" id="Flow_1001"/>
    <sequenceFlow sourceRef="Task_ClientGetPending" targetRef="Task_ClientGetWork" id="Flow_1002"/>
    <sequenceFlow sourceRef="Task_ClientGetWork" targetRef="Task_ExternalFund" id="Flow_1003"/>
  </process>
  <process id="Process_WebApp" isExecutable="false">
    <laneSet id="LaneSet_WebApp">
      <lane id="Lane_API" name="API Routes">
        <flowNodeRef>Start_WebAccountInfo</flowNodeRef>
        <flowNodeRef>Task_ValidateAccountInfo</flowNodeRef>
        <flowNodeRef>Start_WebPending</flowNodeRef>
        <flowNodeRef>Task_ValidatePending</flowNodeRef>
        <flowNodeRef>Start_WebWork</flowNodeRef>
        <flowNodeRef>Task_ValidateWork</flowNodeRef>
        <flowNodeRef>Start_WebBroadcast</flowNodeRef>
        <flowNodeRef>Task_ValidateBroadcast</flowNodeRef>
        <flowNodeRef>Start_WebDeposit</flowNodeRef>
        <flowNodeRef>Task_ValidateDepositReq</flowNodeRef>
        <flowNodeRef>Start_WebProve</flowNodeRef>
        <flowNodeRef>Task_ValidateProveReq</flowNodeRef>
        <flowNodeRef>Start_WebWithdraw</flowNodeRef>
        <flowNodeRef>Task_ValidateWithdrawReq</flowNodeRef>
        <flowNodeRef>Task_WebCallNanoRPC</flowNodeRef>
        <flowNodeRef>Task_WebForwardDeposit</flowNodeRef>
        <flowNodeRef>Task_WebForwardProve</flowNodeRef>
        <flowNodeRef>Task_WebForwardWithdraw</flowNodeRef>
        <flowNodeRef>Task_WebReturnResponse</flowNodeRef>
        <flowNodeRef>End_WebOK</flowNodeRef>
        <flowNodeRef>End_WebError</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_WebAccountInfo" name="GET /api/account_info"/>
    <task id="Task_ValidateAccountInfo" name="Validate address, rate limit, CORS"/>
    <sequenceFlow id="WA1" sourceRef="Start_WebAccountInfo" targetRef="Task_ValidateAccountInfo"/>
    <sequenceFlow id="WA2" sourceRef="Task_ValidateAccountInfo" targetRef="Task_WebCallNanoRPC"/>
    <startEvent id="Start_WebPending" name="GET /api/pending"/>
    <task id="Task_ValidatePending" name="Validate address, rate limit"/>
    <sequenceFlow id="WP1" sourceRef="Start_WebPending" targetRef="Task_ValidatePending"/>
    <sequenceFlow id="WP2" sourceRef="Task_ValidatePending" targetRef="Task_WebCallNanoRPC"/>
    <startEvent id="Start_WebWork" name="POST /api/work"/>
    <task id="Task_ValidateWork" name="Validate hash &amp; difficulty, rate limit; request work from rpc.nano.to only (no local fallback)"/>
    <sequenceFlow id="WW1" sourceRef="Start_WebWork" targetRef="Task_ValidateWork"/>
    <sequenceFlow id="WW2" sourceRef="Task_ValidateWork" targetRef="Task_WebCallNanoRPC"/>
    <startEvent id="Start_WebBroadcast" name="POST /api/broadcast"/>
    <task id="Task_ValidateBroadcast" name="Validate block shape, rate limit"/>
    <sequenceFlow id="WB1" sourceRef="Start_WebBroadcast" targetRef="Task_ValidateBroadcast"/>
    <sequenceFlow id="WB2" sourceRef="Task_ValidateBroadcast" targetRef="Task_WebCallNanoRPC"/>
    <startEvent id="Start_WebDeposit" name="POST /api/deposit"/>
    <task id="Task_ValidateDepositReq" name="Validate hashes, API key"/>
    <sequenceFlow id="WD1" sourceRef="Start_WebDeposit" targetRef="Task_ValidateDepositReq"/>
    <sequenceFlow id="WD2" sourceRef="Task_ValidateDepositReq" targetRef="Task_WebForwardDeposit"/>
    <startEvent id="Start_WebProve" name="POST /api/prove"/>
    <task id="Task_ValidateProveReq" name="Validate n, t, P_w, nullifier, denom, epoch, API key"/>
    <sequenceFlow id="WPr1" sourceRef="Start_WebProve" targetRef="Task_ValidateProveReq"/>
    <sequenceFlow id="WPr2" sourceRef="Task_ValidateProveReq" targetRef="Task_WebForwardProve"/>
    <startEvent id="Start_WebWithdraw" name="POST /api/withdraw"/>
    <task id="Task_ValidateWithdrawReq" name="Validate destination, proof, publicSignals"/>
    <sequenceFlow id="WWi1" sourceRef="Start_WebWithdraw" targetRef="Task_ValidateWithdrawReq"/>
    <sequenceFlow id="WWi2" sourceRef="Task_ValidateWithdrawReq" targetRef="Task_WebForwardWithdraw"/>
    <task id="Task_WebCallNanoRPC" name="Proxy only to rpc.nano.to (account_info, pending, work_generate, process); no fallback endpoints"/>
    <task id="Task_WebForwardDeposit" name="Forward to BlackBird Indexer /api/deposit"/>
    <task id="Task_WebForwardProve" name="Forward to BlackBird Indexer /api/prove"/>
    <task id="Task_WebForwardWithdraw" name="Forward to BlackBird Guardian /withdraw"/>
    <task id="Task_WebReturnResponse" name="Return JSON response to client"/>
    <endEvent id="End_WebOK" name="200 OK"/>
    <endEvent id="End_WebError" name="4xx/5xx error"/>
    <sequenceFlow id="W1" sourceRef="Task_WebCallNanoRPC" targetRef="Task_WebReturnResponse"/>
    <sequenceFlow id="W2" sourceRef="Task_WebForwardDeposit" targetRef="Task_WebReturnResponse"/>
    <sequenceFlow id="W3" sourceRef="Task_WebForwardProve" targetRef="Task_WebReturnResponse"/>
    <sequenceFlow id="W4" sourceRef="Task_WebForwardWithdraw" targetRef="Task_WebReturnResponse"/>
    <sequenceFlow id="W5" sourceRef="Task_WebReturnResponse" targetRef="End_WebOK"/>
  </process>
  <process id="Process_NanoRPC" isExecutable="false">
    <laneSet id="LaneSet_NanoRPC">
      <lane id="Lane_RPCNode" name="rpc.nano.to">
        <flowNodeRef>Start_NanoRPC</flowNodeRef>
        <flowNodeRef>Task_AuthRequest</flowNodeRef>
        <flowNodeRef>Gateway_RPCAction</flowNodeRef>
        <flowNodeRef>Task_RPCAccountInfo</flowNodeRef>
        <flowNodeRef>Task_RPCPending</flowNodeRef>
        <flowNodeRef>Task_RPCWorkGenerate</flowNodeRef>
        <flowNodeRef>Task_RPCProcess</flowNodeRef>
        <flowNodeRef>Task_RPCBlocksInfo</flowNodeRef>
        <flowNodeRef>Task_RPCReturn</flowNodeRef>
        <flowNodeRef>End_NanoRPC</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_NanoRPC" name="RPC request received"/>
    <task id="Task_AuthRequest" name="Authenticate API key"/>
    <exclusiveGateway id="Gateway_RPCAction" name="Action?"/>
    <task id="Task_RPCAccountInfo" name="account_info"/>
    <task id="Task_RPCPending" name="pending / receivable"/>
    <task id="Task_RPCWorkGenerate" name="work_generate for requested difficulty threshold"/>
    <task id="Task_RPCProcess" name="process (broadcast block)"/>
    <task id="Task_RPCBlocksInfo" name="blocks_info"/>
    <task id="Task_RPCReturn" name="Return JSON result"/>
    <endEvent id="End_NanoRPC" name="RPC response"/>
    <sequenceFlow id="NR1" sourceRef="Start_NanoRPC" targetRef="Task_AuthRequest"/>
    <sequenceFlow id="NR2" sourceRef="Task_AuthRequest" targetRef="Gateway_RPCAction"/>
    <sequenceFlow id="NR3_Account" sourceRef="Gateway_RPCAction" targetRef="Task_RPCAccountInfo" name="account_info"/>
    <sequenceFlow id="NR3_Pending" sourceRef="Gateway_RPCAction" targetRef="Task_RPCPending" name="pending"/>
    <sequenceFlow id="NR3_Work" sourceRef="Gateway_RPCAction" targetRef="Task_RPCWorkGenerate" name="work_generate"/>
    <sequenceFlow id="NR3_Process" sourceRef="Gateway_RPCAction" targetRef="Task_RPCProcess" name="process"/>
    <sequenceFlow id="NR3_Blocks" sourceRef="Gateway_RPCAction" targetRef="Task_RPCBlocksInfo" name="blocks_info"/>
    <sequenceFlow id="NR4_Account" sourceRef="Task_RPCAccountInfo" targetRef="Task_NanoRPCBroadcast"/>
    <sequenceFlow id="NR4_Pending" sourceRef="Task_RPCPending" targetRef="Task_NanoRPCBroadcast"/>
    <sequenceFlow id="NR4_Work" sourceRef="Task_RPCWorkGenerate" targetRef="Task_NanoRPCBroadcast"/>
    <sequenceFlow id="NR4_Process" sourceRef="Task_RPCProcess" targetRef="Task_NanoRPCBroadcast"/>
    <sequenceFlow id="NR4_Blocks" sourceRef="Task_RPCBlocksInfo" targetRef="Task_NanoRPCBroadcast"/>
    <task id="Task_NanoRPCBroadcast" name="Relay to Nano network node"/>
    <sequenceFlow id="NR5" sourceRef="Task_NanoRPCBroadcast" targetRef="Task_RPCReturn"/>
    <sequenceFlow id="NR6" sourceRef="Task_RPCReturn" targetRef="End_NanoRPC"/>
  </process>
  <process id="Process_Ledger" isExecutable="false">
    <laneSet id="LaneSet_Ledger">
      <lane id="Lane_NanoNode" name="Nano nodes">
        <flowNodeRef>Start_LedgerBlock</flowNodeRef>
        <flowNodeRef>Task_ValidateBlockFormat</flowNodeRef>
        <flowNodeRef>Task_ValidateWork</flowNodeRef>
        <flowNodeRef>Task_ValidateSignature</flowNodeRef>
        <flowNodeRef>Task_CheckAccountState</flowNodeRef>
        <flowNodeRef>Task_ORVConsensus</flowNodeRef>
        <flowNodeRef>Task_LedgerConfirmed</flowNodeRef>
        <flowNodeRef>End_LedgerBlock</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_LedgerBlock" name="Block received from RPC"/>
    <task id="Task_ValidateBlockFormat" name="Validate state block fields"/>
    <task id="Task_ValidateWork" name="Validate PoW against previous / pubkey"/>
    <task id="Task_ValidateSignature" name="Validate Ed25519-blake2b signature"/>
    <task id="Task_CheckAccountState" name="Check balance, previous, link"/>
    <task id="Task_ORVConsensus" name="Open Representative Voting consensus"/>
    <task id="Task_LedgerConfirmed" name="Confirm block"/>
    <endEvent id="End_LedgerBlock" name="Confirmed on-chain"/>
    <sequenceFlow id="L1" sourceRef="Start_LedgerBlock" targetRef="Task_ValidateBlockFormat"/>
    <sequenceFlow id="L2" sourceRef="Task_ValidateBlockFormat" targetRef="Task_ValidateWork"/>
    <sequenceFlow id="L3" sourceRef="Task_ValidateWork" targetRef="Task_ValidateSignature"/>
    <sequenceFlow id="L4" sourceRef="Task_ValidateSignature" targetRef="Task_CheckAccountState"/>
    <sequenceFlow id="L5" sourceRef="Task_CheckAccountState" targetRef="Task_ORVConsensus"/>
    <sequenceFlow id="L6" sourceRef="Task_ORVConsensus" targetRef="Task_LedgerConfirmed"/>
    <sequenceFlow id="L7" sourceRef="Task_LedgerConfirmed" targetRef="End_LedgerBlock"/>
  </process>
  <process id="Process_Indexer" isExecutable="false">
    <laneSet id="LaneSet_Indexer">
      <lane id="Lane_IndexerCore" name="Indexer Core">
        <flowNodeRef>Start_IndexerScan</flowNodeRef>
        <flowNodeRef>Task_QueryConfirmedBlocks</flowNodeRef>
        <flowNodeRef>Task_FilterSendsToPool</flowNodeRef>
        <flowNodeRef>Task_IndexerBlocksInfo</flowNodeRef>
        <flowNodeRef>Task_ValidatePair</flowNodeRef>
        <flowNodeRef>Gateway_PairValid</flowNodeRef>
        <flowNodeRef>Task_ComputeEpoch</flowNodeRef>
        <flowNodeRef>Task_ComputeLeaf</flowNodeRef>
        <flowNodeRef>Task_InsertTree</flowNodeRef>
        <flowNodeRef>Task_ComputeRoot</flowNodeRef>
        <flowNodeRef>Task_PersistIndexerState</flowNodeRef>
        <flowNodeRef>Task_PublishRootAPI</flowNodeRef>
        <flowNodeRef>Start_IndexerDeposit</flowNodeRef>
        <flowNodeRef>Task_IndexerDepositVerify</flowNodeRef>
        <flowNodeRef>Gateway_DepositKnown</flowNodeRef>
        <flowNodeRef>Task_IndexerDepositAdd</flowNodeRef>
        <flowNodeRef>Start_IndexerProve</flowNodeRef>
        <flowNodeRef>Task_FetchMerkleProof</flowNodeRef>
        <flowNodeRef>Task_GenerateProofInputs</flowNodeRef>
        <flowNodeRef>Task_ServeProof</flowNodeRef>
        <flowNodeRef>End_IndexerOK</flowNodeRef>
        <flowNodeRef>End_IndexerReject</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_IndexerScan" name="Confirmed blocks available"/>
    <task id="Task_QueryConfirmedBlocks" name="Query account_history for pool addresses"/>
    <task id="Task_FilterSendsToPool" name="Filter sends matching allowed denominations"/>
    <task id="Task_IndexerBlocksInfo" name="blocks_info(deposit_hash, commit_hash)"/>
    <task id="Task_ValidatePair" name="Validate: state blocks, confirmed, same source, amount in DENOMINATIONS, deposit link == pool_pubkey, commit previous == deposit hash, commit amount == 1 raw, C 32 bytes"/>
    <exclusiveGateway id="Gateway_PairValid" name="Valid pair?"/>
    <task id="Task_ComputeEpoch" name="Compute epoch = local_timestamp // 86400"/>
    <task id="Task_ComputeLeaf" name="leaf = Poseidon(C, 0)"/>
    <task id="Task_InsertTree" name="Insert into per-epoch/denom Merkle tree (depth 20)"/>
    <task id="Task_ComputeRoot" name="Compute deterministic root"/>
    <task id="Task_PersistIndexerState" name="Atomic write of indexer_state.json with 0o600 permissions"/>
    <task id="Task_PublishRootAPI" name="Expose /root/{epoch}/{denom} and /status"/>
    <endEvent id="End_IndexerScanOK" name="Root updated"/>
    <endEvent id="End_IndexerScanReject" name="Invalid pair ignored"/>
    <sequenceFlow id="IS1" sourceRef="Start_IndexerScan" targetRef="Task_QueryConfirmedBlocks"/>
    <sequenceFlow id="IS2" sourceRef="Task_QueryConfirmedBlocks" targetRef="Task_FilterSendsToPool"/>
    <sequenceFlow id="IS3" sourceRef="Task_FilterSendsToPool" targetRef="Task_IndexerBlocksInfo"/>
    <sequenceFlow id="IS4" sourceRef="Task_IndexerBlocksInfo" targetRef="Task_ValidatePair"/>
    <sequenceFlow id="IS5" sourceRef="Task_ValidatePair" targetRef="Gateway_PairValid"/>
    <sequenceFlow id="IS6_No" sourceRef="Gateway_PairValid" targetRef="End_IndexerScanReject" name="No"/>
    <sequenceFlow id="IS6_Yes" sourceRef="Gateway_PairValid" targetRef="Task_ComputeEpoch" name="Yes"/>
    <sequenceFlow id="IS7" sourceRef="Task_ComputeEpoch" targetRef="Task_ComputeLeaf"/>
    <sequenceFlow id="IS8" sourceRef="Task_ComputeLeaf" targetRef="Task_InsertTree"/>
    <sequenceFlow id="IS9" sourceRef="Task_InsertTree" targetRef="Task_ComputeRoot"/>
    <sequenceFlow id="IS10" sourceRef="Task_ComputeRoot" targetRef="Task_PersistIndexerState"/>
    <sequenceFlow id="IS11" sourceRef="Task_PersistIndexerState" targetRef="Task_PublishRootAPI"/>
    <sequenceFlow id="IS12" sourceRef="Task_PublishRootAPI" targetRef="End_IndexerScanOK"/>
    <startEvent id="Start_IndexerDeposit" name="POST /api/deposit"/>
    <task id="Task_IndexerDepositVerify" name="require_api_key + verify_deposit_commitment_pair()"/>
    <exclusiveGateway id="Gateway_DepositKnown" name="Pair valid?"/>
    <task id="Task_IndexerDepositAdd" name="add_commitment(epoch, denom, C)"/>
    <endEvent id="End_IndexerDepositOK" name="Return {ok, commitment, epoch}"/>
    <endEvent id="End_IndexerDepositReject" name="Return 400 invalid pair"/>
    <sequenceFlow id="ID1" sourceRef="Start_IndexerDeposit" targetRef="Task_IndexerDepositVerify"/>
    <sequenceFlow id="ID2" sourceRef="Task_IndexerDepositVerify" targetRef="Gateway_DepositKnown"/>
    <sequenceFlow id="ID3_No" sourceRef="Gateway_DepositKnown" targetRef="End_IndexerDepositReject" name="No"/>
    <sequenceFlow id="ID3_Yes" sourceRef="Gateway_DepositKnown" targetRef="Task_IndexerDepositAdd" name="Yes"/>
    <sequenceFlow id="ID4" sourceRef="Task_IndexerDepositAdd" targetRef="End_IndexerDepositOK"/>
    <startEvent id="Start_IndexerProve" name="POST /api/prove"/>
    <task id="Task_FetchMerkleProof" name="get_proof(epoch, denom, C)"/>
    <task id="Task_GenerateProofInputs" name="Build snarkjs input signals (root, nullifier, limbs, path, indices)"/>
    <task id="Task_ServeProof" name="Run snarkjs groth16.fullProve; return proof + publicSignals"/>
    <endEvent id="End_IndexerProveOK" name="Return proof"/>
    <sequenceFlow id="IP1" sourceRef="Start_IndexerProve" targetRef="Task_FetchMerkleProof"/>
    <sequenceFlow id="IP2" sourceRef="Task_FetchMerkleProof" targetRef="Task_GenerateProofInputs"/>
    <sequenceFlow id="IP3" sourceRef="Task_GenerateProofInputs" targetRef="Task_ServeProof"/>
    <sequenceFlow id="IP4" sourceRef="Task_ServeProof" targetRef="End_IndexerProveOK"/>
    <endEvent id="End_IndexerOK" name="OK"/>
    <endEvent id="End_IndexerReject" name="Reject"/>
  </process>
  <process id="Process_Guardian" isExecutable="false">
    <laneSet id="LaneSet_Guardian">
      <lane id="Lane_GuardianNode" name="Guardian (single-key prototype)">
        <flowNodeRef>Start_GuardianWithdraw</flowNodeRef>
        <flowNodeRef>Task_ParseRequest</flowNodeRef>
        <flowNodeRef>Task_VerifyPublicSignals</flowNodeRef>
        <flowNodeRef>Gateway_PublicSignalsOK</flowNodeRef>
        <flowNodeRef>Task_FetchIndexerRoot</flowNodeRef>
        <flowNodeRef>Gateway_RootMatches</flowNodeRef>
        <flowNodeRef>Task_CheckNullifier</flowNodeRef>
        <flowNodeRef>Gateway_NullifierFresh</flowNodeRef>
        <flowNodeRef>Task_GuardianAccountInfo</flowNodeRef>
        <flowNodeRef>Task_ComputeNewBalance</flowNodeRef>
        <flowNodeRef>Task_HashBlock</flowNodeRef>
        <flowNodeRef>Task_SignBlock</flowNodeRef>
        <flowNodeRef>Task_MarkNullifier</flowNodeRef>
        <flowNodeRef>Task_PersistGuardianState</flowNodeRef>
        <flowNodeRef>Task_ReturnBlock</flowNodeRef>
        <flowNodeRef>Task_RejectRequest</flowNodeRef>
        <flowNodeRef>End_GuardianSigned</flowNodeRef>
        <flowNodeRef>End_GuardianRejected</flowNodeRef>
        <flowNodeRef>Task_VerifyZKProof</flowNodeRef>
        <flowNodeRef>Gateway_ProofValid</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_GuardianWithdraw" name="POST /withdraw"/>
    <task id="Task_ParseRequest" name="require_api_key + parse epoch, denom, P_w, nullifier, proof, publicSignals"/>
    <task id="Task_VerifyPublicSignals" name="Check publicSignals[1]==nullifier, [2,3]==P_w limbs"/>
    <exclusiveGateway id="Gateway_PublicSignalsOK" name="Signals match?"/>
    <task id="Task_FetchIndexerRoot" name="GET /root/{epoch}/{denom} from indexer"/>
    <exclusiveGateway id="Gateway_RootMatches" name="Root matches?"/>
    <task id="Task_CheckNullifier" name="Check nullifier not in spent set"/>
    <exclusiveGateway id="Gateway_NullifierFresh" name="Fresh?"/>
    <task id="Task_VerifyZKProof" name="snarkjs verify(proof, publicSignals)"/>
    <exclusiveGateway id="Gateway_ProofValid" name="Proof valid?"/>
    <task id="Task_GuardianAccountInfo" name="Get pool account_info (frontier, balance, rep)"/>
    <task id="Task_ComputeNewBalance" name="new_balance = balance - (denom - 0.5% fee)"/>
    <task id="Task_HashBlock" name="block_hash = Blake2b(32-byte preamble|account|previous|rep|balance|link=P_w)"/>
    <task id="Task_SignBlock" name="Sign block_hash with pool Ed25519-blake2b key"/>
    <task id="Task_MarkNullifier" name="Move nullifier from pending to spent after successful broadcast"/>
    <task id="Task_PersistGuardianState" name="Atomic write of guardian_state.json with 0o600 permissions"/>
    <task id="Task_ReturnBlock" name="Return {block, block_hash, nullifier}; store as pending (not spent)"/>
    <task id="Task_RejectRequest" name="Return {error: verification failed}"/>
    <endEvent id="End_GuardianSigned" name="Signed block returned"/>
    <endEvent id="End_GuardianRejected" name="Request rejected"/>
    <sequenceFlow id="GU1" sourceRef="Start_GuardianWithdraw" targetRef="Task_ParseRequest"/>
    <sequenceFlow id="GU2" sourceRef="Task_ParseRequest" targetRef="Task_VerifyPublicSignals"/>
    <sequenceFlow id="GU3" sourceRef="Task_VerifyPublicSignals" targetRef="Gateway_PublicSignalsOK"/>
    <sequenceFlow id="GU4_No" sourceRef="Gateway_PublicSignalsOK" targetRef="Task_RejectRequest" name="No"/>
    <sequenceFlow id="GU4_Yes" sourceRef="Gateway_PublicSignalsOK" targetRef="Task_FetchIndexerRoot" name="Yes"/>
    <sequenceFlow id="GU5" sourceRef="Task_FetchIndexerRoot" targetRef="Gateway_RootMatches"/>
    <sequenceFlow id="GU6_No" sourceRef="Gateway_RootMatches" targetRef="Task_RejectRequest" name="No"/>
    <sequenceFlow id="GU6_Yes" sourceRef="Gateway_RootMatches" targetRef="Task_CheckNullifier" name="Yes"/>
    <sequenceFlow id="GU7" sourceRef="Task_CheckNullifier" targetRef="Gateway_NullifierFresh"/>
    <sequenceFlow id="GU8_No" sourceRef="Gateway_NullifierFresh" targetRef="Task_RejectRequest" name="No"/>
    <sequenceFlow id="GU8_Yes" sourceRef="Gateway_NullifierFresh" targetRef="Task_VerifyZKProof" name="Yes"/>
    <sequenceFlow id="GU9" sourceRef="Task_VerifyZKProof" targetRef="Gateway_ProofValid"/>
    <sequenceFlow id="GU10_No" sourceRef="Gateway_ProofValid" targetRef="Task_RejectRequest" name="No"/>
    <sequenceFlow id="GU10_Yes" sourceRef="Gateway_ProofValid" targetRef="Task_GuardianAccountInfo" name="Yes"/>
    <sequenceFlow id="GU11" sourceRef="Task_GuardianAccountInfo" targetRef="Task_ComputeNewBalance"/>
    <sequenceFlow id="GU12" sourceRef="Task_ComputeNewBalance" targetRef="Task_HashBlock"/>
    <sequenceFlow id="GU13" sourceRef="Task_HashBlock" targetRef="Task_SignBlock"/>
    <sequenceFlow id="GU14" sourceRef="Task_SignBlock" targetRef="Task_MarkNullifier"/>
    <sequenceFlow id="GU15" sourceRef="Task_MarkNullifier" targetRef="Task_PersistGuardianState"/>
    <sequenceFlow id="GU16" sourceRef="Task_PersistGuardianState" targetRef="Task_ReturnBlock"/>
    <sequenceFlow id="GU17" sourceRef="Task_ReturnBlock" targetRef="End_GuardianSigned"/>
    <sequenceFlow id="GU18" sourceRef="Task_RejectRequest" targetRef="End_GuardianRejected"/>
  </process>
